#!/bin/sh
# $3 is 1 for branch checkouts, 0 for file restores — skip file restores
if [ "$3" != "1" ]; then
  exit 0
fi

# Suppress deletion noise for the beads passive export in worktrees.
if git ls-files --error-unmatch .beads/issues.jsonl > /dev/null 2>&1; then
  git update-index --skip-worktree .beads/issues.jsonl
fi

# Branch switches use the same canonical, portable updater as post-commit.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
if [ -x "$ROOT/scripts/update-knowledge-graphs.sh" ]; then
  nohup "$ROOT/scripts/update-knowledge-graphs.sh" </dev/null >/dev/null 2>&1 &
fi
