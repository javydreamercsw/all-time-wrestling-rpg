#!/bin/sh

##### SECRET SCAN START #####
# Scan tracked .mv.db files for common API key patterns
SECRET_PATTERNS="AIzaSy|sk-ant-api|sk-proj-|AKIA[0-9A-Z]{16}"
DB_FILES=$(git ls-files '*.mv.db')
if [ -n "$DB_FILES" ]; then
    for db_file in $DB_FILES; do
        if strings "$db_file" | grep -qE "$SECRET_PATTERNS"; then
            echo 1>&2 "ERROR: Possible secret found in $db_file. Remove the secret before pushing."
            strings "$db_file" | grep -oE "$SECRET_PATTERNS[^'\"[:space:]]*" 1>&2 || true
            exit 1
        fi
    done
fi
##### SECRET SCAN END #####

##### LOCKFILE REGISTRY GUARD START #####
# Local Maven runs can make the Vaadin plugin re-sync package-lock.json against a
# corporate npm registry (e.g. art01.corp.pingidentity.com). CI runners cannot
# resolve those hosts, so pushing such a lockfile breaks the frontend build.
# The auto-commit below uses `git add -A`, so check the worktree state here.
LOCKFILE="$(git rev-parse --show-toplevel)/package-lock.json"
if [ -f "$LOCKFILE" ] && grep '"resolved": "https://' "$LOCKFILE" | grep -vq 'registry.npmjs.org'; then
    echo 1>&2 "ERROR: package-lock.json contains non-npmjs registry URLs (corporate proxy leak):"
    grep -o '"resolved": "https://[^/]*' "$LOCKFILE" | sort -u | grep -v 'registry.npmjs.org' 1>&2
    echo 1>&2 "Restore it with: git checkout -- package.json package-lock.json"
    exit 1
fi
##### LOCKFILE REGISTRY GUARD END #####

EXECUTOR="$(git rev-parse --show-toplevel)/mvnw"

##### SPOTLESS + OPENREWRITE HOOK START #####
# Apply spotless to give rewrite a clean base
$EXECUTOR spotless:apply

# Only run rewrite if .java files are being pushed — it scans all sources and is slow
BRANCH=$(git rev-parse --abbrev-ref HEAD)
UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo "origin/$BRANCH")
if git diff --name-only HEAD "$UPSTREAM" 2>/dev/null | grep -q '\.java$'; then
  # Skip spotless:check inside rewrite to avoid the circular spotless↔rewrite failure
  $EXECUTOR rewrite:run -Dspotless.check.skip=true
  # Re-apply spotless to fix any formatting that rewrite introduced
  $EXECUTOR spotless:apply
fi

# The spotless run above can itself re-sync the lockfile through a corporate
# registry. Restore both npm files before the auto-commit sweeps them up.
if ! git diff --quiet HEAD -- package-lock.json 2>/dev/null \
    && grep '"resolved": "https://' "$LOCKFILE" | grep -vq 'registry.npmjs.org'; then
  echo 1>&2 "NOTICE: discarding corporate-registry lockfile churn from the formatting run."
  git checkout -- package.json package-lock.json
fi

# If either tool changed anything, commit the fixes and abort the push.
# Git has already resolved HEAD's SHA before invoking this hook, so a new
# commit created here would not be included in the push that triggered it.
# Aborting with exit 1 ensures the formatting commit is at the tip on the
# next push — just re-run "git push".
if ! git diff --quiet HEAD; then
  echo 1>&2 "Spotless/OpenRewrite applied formatting fixes. Committing them now."
  git add -A
  git commit -m "style: auto-fix Spotless/OpenRewrite formatting"
  echo 1>&2 "Re-run 'git push' to include the formatting commit."
  exit 1
fi
##### SPOTLESS + OPENREWRITE HOOK END #####
